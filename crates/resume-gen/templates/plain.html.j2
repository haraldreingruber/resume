{% set b = resume.basics %}
<!doctype html>
<!-- GENERATED by resume-gen from content/resume.yaml -- do not edit; run `cargo gen html`. -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ b.name }} – Resume</title>
<meta name="description" content="{{ b.name }} – {{ b.label }}">
<style>
  :root {
    color-scheme: light dark;
    --bg: #ffffff;
    --surface: #f4f7fa;
    --text: #2e2e2e;
    --muted: #666666;
    --heading: #03396c;
    --accent: #005b96;
    --rule: #6497b1;
    --border: #d5dde5;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #10161d;
      --surface: #18212b;
      --text: #e6e9ec;
      --muted: #a3acb5;
      --heading: #8cc4ef;
      --accent: #6db3e8;
      --rule: #4f7f99;
      --border: #2b3947;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.55 "Lato", "Segoe UI", system-ui, -apple-system, sans-serif;
  }
  a { color: var(--accent); }
  main { max-width: 64rem; margin: 0 auto; padding: 2.5rem 1rem 4rem; }
  header h1 {
    margin: 0;
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .tagline { margin: 0.4rem 0 0.8rem; color: var(--accent); font-size: 1.15rem; font-weight: 700; }
  .contact, .actions { display: flex; flex-wrap: wrap; gap: 0.35rem 1.4rem; margin: 0; padding: 0; list-style: none; }
  .contact { color: var(--muted); font-size: 0.95rem; }
  .actions { margin-top: 1rem; }
  .actions a {
    display: inline-block;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
  }
  .notice {
    margin: 1.2rem 0 0;
    padding: 0.75rem 1rem;
    background: var(--surface);
    border-left: 4px solid var(--rule);
    border-radius: 4px;
  }
  .columns { display: grid; gap: 0 3rem; margin-top: 1rem; }
  @media (min-width: 52rem) { .columns { grid-template-columns: 1.85fr 1fr; } }
  h2 {
    margin: 2rem 0 0.9rem;
    padding-bottom: 0.2rem;
    border-bottom: 2px solid var(--rule);
    color: var(--heading);
    font-size: 1.35rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  h3 { margin: 0; font-size: 1.1rem; }
  article { padding-bottom: 1rem; margin-bottom: 1rem; border-bottom: 1px dashed var(--border); }
  article:last-child { border-bottom: 0; }
  .org { margin: 0.1rem 0 0; color: var(--accent); font-weight: 700; }
  .meta { margin: 0.15rem 0 0.4rem; color: var(--muted); font-size: 0.9rem; }
  article ul { margin: 0.4rem 0 0; padding-left: 1.2rem; }
  article li { margin: 0.2rem 0; }
  article p { margin: 0.35rem 0 0; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.4rem 0 1rem; padding: 0; list-style: none; }
  .tags li { padding: 0.15rem 0.6rem; border: 1px solid var(--border); border-radius: 6px; font-size: 0.92rem; }
  h4 { margin: 0.8rem 0 0; font-size: 0.95rem; }
  @media print {
    .actions, .notice { display: none !important; }
    main { padding: 0; }
  }
</style>
</head>
<body>
<main>
  <header>
    <h1>{{ b.name }}</h1>
    <p class="tagline">{{ b.label }}</p>
    <ul class="contact">
      <li><a href="mailto:{{ b.email }}">{{ b.email }}</a></li>
      <li>{{ b.location | location }}</li>
      {% for p in b.profiles %}
      <li><a href="{{ p.url }}">{{ p.network }}</a></li>
      {% endfor %}
    </ul>
    <ul class="actions">
      <li id="link-3d"><a href="./">View the 3D resume</a></li>
      <li><a href="{{ pdf_file }}">Download PDF</a></li>
    </ul>
    <p class="notice" id="no-webgpu" hidden>Your browser doesn't support WebGPU, so you're seeing the plain version of this resume. The 3D version runs in current Chrome, Edge and Safari, and in Firefox on Windows.</p>
  </header>

  <div class="columns">
    <div>
      <section aria-labelledby="summary">
        <h2 id="summary">Summary</h2>
        <p>{{ b.summary | html }}</p>
      </section>

      <section aria-labelledby="experience">
        <h2 id="experience">Experience</h2>
        {% for w in resume.work %}
        <article>
          <h3>{{ w.position }}</h3>
          <p class="org">{{ w.organization }}</p>
          <p class="meta">{{ w.dates | dates }}{% if w.location %} · {{ w.location }}{% endif %}</p>
          <ul>
            {% for h in w.highlights %}
            <li>{{ h | html }}</li>
            {% endfor %}
          </ul>
        </article>
        {% endfor %}
      </section>

      <section aria-labelledby="projects">
        <h2 id="projects">Selected Projects &amp; Research</h2>
        {% for p in resume.projects %}
        <article>
          <h3>{{ p | heading }}</h3>
          <p class="meta">{{ p.dates | dates }}{% if p.location %} · {{ p.location }}{% endif %}</p>
          <p>“{{ p.title }}”{% if p.description %} – {{ p.description | html }}{% endif %}</p>
        </article>
        {% endfor %}
      </section>
    </div>

    <div>
      <section aria-labelledby="skills">
        <h2 id="skills">Skills</h2>
        {% for g in resume.skills %}
        <h4>{{ g.name }}</h4>
        <ul class="tags">
          {% for k in g.keywords %}
          <li>{{ k }}</li>
          {% endfor %}
        </ul>
        {% endfor %}
      </section>

      <section aria-labelledby="education">
        <h2 id="education">Education</h2>
        {% for e in resume.education %}
        <article>
          <h3>{{ e | title }}</h3>
          <p class="org">{{ e.institution }}</p>
          <p class="meta">{{ e.dates | dates }}{% if e.location %} · {{ e.location }}{% endif %}</p>
          {% if e | courses %}
          <p>{{ e | courses }}</p>
          {% endif %}
        </article>
        {% endfor %}
      </section>

      <section aria-labelledby="languages">
        <h2 id="languages">Languages</h2>
        <ul class="tags">
          {% for l in resume.languages %}
          <li>{{ l | language }}</li>
          {% endfor %}
        </ul>
      </section>
    </div>
  </div>
</main>
<script>
  // index.html redirects here with ?no-webgpu when WebGPU is unavailable.
  if (new URLSearchParams(location.search).has("no-webgpu")) {
    document.getElementById("no-webgpu").hidden = false;
    document.getElementById("link-3d").hidden = true;
  }
</script>
</body>
</html>
