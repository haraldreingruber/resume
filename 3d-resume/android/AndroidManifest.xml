<?xml version="1.0" encoding="utf-8"?>
<!-- A NativeActivity app: no Java/Kotlin code; the activity loads
     libresume_3d.so and calls its android_main. Built by build-apk.sh. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.haraldreingruber.resume">

    <application
        android:label="3D Resume"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="false"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <!-- Rotation and resizing are handled by the app (a resize event), so
             the activity isn't restarted for them. -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density">
            <meta-data android:name="android.app.lib_name" android:value="resume_3d" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
